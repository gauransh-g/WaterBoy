# WaterBoy Environment Configuration

# Optional: Google Gemini API Key for rich LLM synthesis (fallback is high-precision local synthesizer)
GEMINI_API_KEY=

# Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

